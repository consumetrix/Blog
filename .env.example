APP_NAME="Consumetrix Blog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Staging (server .env): APP_ENV=staging, APP_URL=https://eugeneagben.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Blog settings (config/blog.php)
BLOG_NAME="Consumetrix Blog"
BLOG_COMPANY=Consumetrix
BLOG_TAGLINE="Technology, governance and transformation, explained plainly."
BLOG_MAIN_SITE=https://consumetrix.biz
BLOG_CONTACT_URL=https://consumetrix.biz/talk-to-us

# Dashboard sign-in asks for a code from an authenticator app after the password.
# Set to false to turn it off (e.g. on a local copy).
# LOGIN_TWO_FACTOR=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"
